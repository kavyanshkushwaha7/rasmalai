# Web runtime values. Copy to apps/web/.env.local; never add database admin credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional browser endpoint. If it is localhost and this app is opened from a
# private LAN address (for example, a phone on the same Wi-Fi), the client
# substitutes the page host so localhost refers to the Mac, not the phone.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100

# Server-side launch switch. Keep false in both the web and realtime environments.
# The realtime service loads apps/web/.env.local for local development.
SPECTATOR_MODE_ENABLED=false

# Authentication policy. Local mode keeps email/password available. For public
# Google-only access use AUTH_BETA_MODE=public-google and GOOGLE_OAUTH_ENABLED=true.
# For invite-only Google access use invite-only-google plus a private allowlist.
AUTH_BETA_MODE=email-password
GOOGLE_OAUTH_ENABLED=false
BETA_ALLOWED_EMAILS=

# Server-only Supabase secret key used for validated avatar storage operations.
# Never prefix this key with NEXT_PUBLIC_ or use it in client modules.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Restricted Prisma runtime role only. Choose the Supabase Transaction pooler URL.
# SSL is enforced with the CA file stored at the project-root-relative path below.
DATABASE_URL=postgresql://prisma.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt

# Optional realtime local service defaults.
REALTIME_PORT=4100
# Bind to loopback for private HTTPS proxy tests; default is 0.0.0.0.
REALTIME_HOST=0.0.0.0
REALTIME_ALLOWED_ORIGIN=http://localhost:3000
