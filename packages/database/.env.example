# Migration-only credential. Keep this out of apps/web and all frontend bundles.
# Use the project admin for Supabase-managed Storage schema changes.
# The CA path is relative to the project root and is resolved by prisma.config.ts.
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
