# Supabase Auth verification for socket handshakes. These are server runtime
# variables; local development can load the equivalent NEXT_PUBLIC values from
# apps/web/.env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Restricted Prisma runtime connection. Use the Transaction Pooler and the
# same CA certificate as the web runtime. Never use DIRECT_URL here.
DATABASE_URL=postgresql://prisma.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt

# Keep the same server-only launch switch as the web service.
SPECTATOR_MODE_ENABLED=false

REALTIME_PORT=4100
REALTIME_HOST=0.0.0.0
# Exact web origin(s), comma-separated if needed. In local development the
# service also allows the Mac's active LAN interface at this web origin's
# scheme/port; production remains exact-origin only.
REALTIME_ALLOWED_ORIGIN=http://localhost:3000
