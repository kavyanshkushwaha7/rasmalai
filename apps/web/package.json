{
  "name": "@rasmalai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:secure-test": "RASMALAI_SECURE_TEST=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts && node --import tsx --test test/online-animation-render.render.tsx test/online-animation-dom.render.tsx",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@rasmalai/database": "*",
    "@rasmalai/game-engine": "*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "socket.io-client": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3"
  }
}
